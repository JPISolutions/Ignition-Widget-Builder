{
  "custom": {
    "siteData": []
  },
  "params": {
    "basePath": "[default]Cappy Hour Inc/Site1",
    "siteSummaryViewPath": "UDT Views/Prove It/Rollups/EntB/site-summary-widget-view"
  },
  "propConfig": {
    "custom.siteData": {
      "binding": {
        "config": {
          "expression": "{view.params.basePath}"
        },
        "transforms": [
          {
            "code": "\tbasePath = value\n\tparts = basePath.rsplit('/', 1)\n\tenterprisePath = parts[0] if len(parts) > 1 else basePath\n\tresult = []\n\tfor i in range(1, 11):\n\t\tsiteName = 'Site' + str(i)\n\t\ttagPath = enterprisePath + '/' + siteName + '/_metadata/assetidentifier/assetname'\n\t\ttry:\n\t\t\tqv = system.tag.readBlocking([tagPath])\n\t\t\tif qv[0].quality.isGood() and qv[0].value is not None:\n\t\t\t\tresult.append({'basePath': enterprisePath + '/' + siteName})\n\t\texcept:\n\t\t\tpass\n\treturn result",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "params.basePath": {
      "binding": {
        "config": {
          "expression": "{session.custom.basePath}"
        },
        "type": "expr"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.siteSummaryViewPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 900,
      "width": 1201
    }
  },
