{
  "custom": {
    "history": [
      {
        "aggregate": "MinMax",
        "alias": "OEE"
      }
    ]
  },
  "params": {
    "basePath": "[default]Path/To/Your/labeler"
  },
  "propConfig": {
    "custom.history": {
      "persistent": true
    },
    "custom.history[0].path": {
      "binding": {
        "config": {
          "expression": "{view.params.basePath}+'/_metric/oee'"
        },
        "type": "expr"
      }
    },
    "params.basePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 320
    }
  },
