      {
        "children": [
          {
            "meta": {
              "name": "ISOCompliance"
            },
            "position": {
              "grow": 2
            },
            "propConfig": {
              "props.params.basePath": {
                "binding": {
                  "config": {
                    "expression": "{view.params.basePath}"
                  },
