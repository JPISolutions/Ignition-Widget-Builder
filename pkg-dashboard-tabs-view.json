{
  "custom": {},
  "params": {
    "basePath": "[default]Cappy Hour Inc/Site1/packaging",
    "lineDashboardViewPath": "UDT Views/Prove It/Rollups/EntB/pkg-dashboard-compact-view"
  },
  "propConfig": {
    "custom.lineData": {
      "binding": {
        "config": {
          "expression": "{view.params.basePath}"
        },
        "transforms": [
          {
            "code": "\tbasePath = value\n\tresult = {'tabs': [], 'paths': []}\n\tfor i in range(1, 11):\n\t\tnum = str(i).zfill(2)\n\t\tlineName = 'labelerline' + num\n\t\ttagPath = basePath + '/' + lineName + '/_metadata/assetidentifier/assetname'\n\t\ttry:\n\t\t\tqv = system.tag.readBlocking([tagPath])\n\t\t\tif qv[0].quality.isGood() and qv[0].value is not None:\n\t\t\t\tresult['tabs'].append(str(qv[0].value))\n\t\t\t\tresult['paths'].append(basePath + '/' + lineName)\n\t\texcept:\n\t\t\tpass\n\treturn result",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "params.basePath": {
      "binding": {
        "config": {
          "expression": "{session.custom.basePath}"
        },
        "type": "expr"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.lineDashboardViewPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 1080,
      "width": 1201
    }
  },
