                "binding": {
                  "config": {
                    "expression": "{view.params.basePath}"
                  },
                  "type": "expr"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "{view.params.batchHouseViewPath}"
                  },
                  "type": "expr"
