{
  "custom": {},
  "params": {
    "basePath": "[default]Path/To/Your/inspector"
  },
  "propConfig": {
    "params.basePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 460,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.tooltip": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/Description"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label",
                "cursor": "help"
              },
              "text": "INSPECTOR",
              "tooltip": ""
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "State"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/State/StateCurrent"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Value"
              },
              "text": "Running"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "State Reason"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/State/StateReason"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Value"
              },
              "text": "--"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "StateReasonRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "YieldGauge"
            },
            "position": {
              "basis": "91.8px"
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "expression": "if(tag({view.params.basePath} + \"/Production/TotalInspected\") > 0, tag({view.params.basePath} + \"/Production/PassCount\") / tag({view.params.basePath} + \"/Production/TotalInspected\") * 100, 0)"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "arc": {
                "width": 10
              },
              "label": {
                "maxDecimal": 1,
                "size": 15
              },
              "maxValue": 100,
              "minValue": 0,
              "style": {
                "marginBottom": 0
              },
              "value": 0
            },
            "type": "ia.chart.simple-gauge"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "MinLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "left"
                  },
                  "text": "0%"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "GaugeLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "center"
                  },
                  "text": "Yield"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "MaxLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "right"
                  },
                  "text": "100%"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "GaugeLabelRow"
            },
            "props": {
              "style": {
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "YieldGaugeContainer"
        },
        "position": {
          "basis": "130px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "justify": "center",
          "style": {
            "classes": "Framework/Card/ContainerWBorder"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "BarLabel"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label",
                "marginBottom": "4px"
              },
              "text": "INSPECTION RESULTS"
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "PassSegment"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "position.grow": {
                    "binding": {
                      "config": {
                        "expression": "max(0.001, tag({view.params.basePath} + \"/Production/PassCount\"))"
                      },
                      "type": "expr"
                    }
                  },
                  "props.tooltip": {
                    "binding": {
                      "config": {
                        "expression": "'Pass: ' + numberformat(tag({view.params.basePath} + \"/Production/PassCount\"), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "backgroundColor": "#4CAF50",
                    "borderRadius": "4px 0 0 4px"
                  },
                  "tooltip": "Pass: 0"
                },
                "type": "ia.container.flex"
              },
              {
                "meta": {
                  "name": "RejectSegment"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "position.grow": {
                    "binding": {
                      "config": {
                        "expression": "max(0.001, tag({view.params.basePath} + \"/Production/RejectCount\"))"
                      },
                      "type": "expr"
                    }
                  },
                  "props.tooltip": {
                    "binding": {
                      "config": {
                        "expression": "'Reject: ' + numberformat(tag({view.params.basePath} + \"/Production/RejectCount\"), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "backgroundColor": "#F44336",
                    "borderRadius": "0 4px 4px 0"
                  },
                  "tooltip": "Reject: 0"
                },
                "type": "ia.container.flex"
              }
            ],
            "meta": {
              "name": "StackedBar"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "height": "20px",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "PassLabel"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'Pass: ' + numberformat(tag({view.params.basePath} + \"/Production/PassCount\"), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "color": "#4CAF50",
                    "fontSize": "0.85em",
                    "textAlign": "left"
                  },
                  "text": "Pass: 0"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "TotalLabel"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'Total: ' + numberformat(tag({view.params.basePath} + \"/Production/TotalInspected\"), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "fontSize": "0.85em",
                    "textAlign": "center"
                  },
                  "text": "Total: 0"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "RejectLabel"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'Reject: ' + numberformat(tag({view.params.basePath} + \"/Production/RejectCount\"), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "color": "#F44336",
                    "fontSize": "0.85em",
                    "textAlign": "right"
                  },
                  "text": "Reject: 0"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "BarLegend"
            },
            "props": {
              "style": {
                "marginTop": "4px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "InspectionBar"
        },
        "position": {
          "basis": "80px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "Framework/Card/ContainerWBorder"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "DEFECT BREAKDOWN"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "DefectHeader"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "DIMLabel"
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "fontSize": "0.85em"
                  },
                  "text": "DIM"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "DIMValue"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "numberformat(tag({view.params.basePath} + \"/Production/DefectDIM\"), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Value",
                    "fontSize": "0.85em"
                  },
                  "text": "0"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "DIMCell"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "alignItems": "center",
              "direction": "column",
              "justify": "center"
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "CHKLabel"
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "fontSize": "0.85em"
                  },
                  "text": "CHK"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "CHKValue"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "numberformat(tag({view.params.basePath} + \"/Production/DefectCHK\"), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Value",
                    "fontSize": "0.85em"
                  },
                  "text": "0"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "CHKCell"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "alignItems": "center",
              "direction": "column",
              "justify": "center"
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "SEDLabel"
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "fontSize": "0.85em"
                  },
                  "text": "SED"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "SEDValue"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "numberformat(tag({view.params.basePath} + \"/Production/DefectSED\"), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Value",
                    "fontSize": "0.85em"
                  },
                  "text": "0"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "SEDCell"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "alignItems": "center",
              "direction": "column",
              "justify": "center"
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "DefectGrid"
        },
        "position": {
          "basis": "60px",
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/ContainerWBorder"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
