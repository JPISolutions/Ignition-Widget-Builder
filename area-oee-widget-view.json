                    "binding": {
                      "config": {
                        "expression": "numberformat(tag({view.params.basePath} + \"/_metric/oee\") * 100, '0.0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "arc": {
                    "width": 10
                  },
                  "label": {
                    "maxDecimal": 1,
                    "size": 15
                  },
                  "maxValue": 100,
                  "minValue": 0,
                  "style": {
                    "marginBottom": 0
                  }
                },
                "type": "ia.chart.simple-gauge"
              },
