            "position": {
              "grow": 1.5
            },
            "propConfig": {
              "props.params.basePath": {
                "binding": {
                  "config": {
                    "expression": "{view.params.basePath}"
                  },
                  "type": "expr"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "{view.params.coldEndViewPath}"
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.view"
          }
