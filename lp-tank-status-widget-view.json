{
  "custom": {},
  "params": {
    "basePath": "[default]Cappy Hour Inc/Site1/liquidprocessing/tankstorage01/tank01"
  },
  "propConfig": {
    "params.basePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 60,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Name"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "basePath": "{view.params.basePath}"
                },
                "tagPath": "{basePath}/_metadata/assetidentifier/assetname"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Label",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "State"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "basePath": "{view.params.basePath}"
                },
                "tagPath": "{basePath}/State/name"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Value",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "center"
    },
    "type": "ia.container.flex"
  }
}
