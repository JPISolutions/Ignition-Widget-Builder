        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.comparisonInstances"
              },
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "expression": "{view.params.lineSummaryViewPath}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "elementPosition": {
            "grow": 1
          },
          "elementStyle": {
            "classes": "Framework/Card/ContainerWBorder"
          },
          "style": {
            "gap": "4px"
          }
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
