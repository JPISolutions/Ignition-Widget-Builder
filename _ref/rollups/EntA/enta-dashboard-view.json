            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.params.basePath": {
                "binding": {
                  "config": {
                    "expression": "{view.params.basePath} + \u0027/Utility/Compressor01\u0027"
                  },
                  "type": "expr"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "{view.params.compressorViewPath}"
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "BottomRow"
        },
        "position": {
          "grow": 1
        },
        "type": "ia.container.flex"
