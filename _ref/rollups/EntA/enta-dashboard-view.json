                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Value",
                    "fontSize": "13px",
                    "fontWeight": "bold",
                    "textAlign": "right"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "ShiftInfo"
            },
            "position": {
              "shrink": 0
