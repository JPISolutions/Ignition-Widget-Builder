            "props": {
              "direction": "column",
              "justify": "center",
              "style": {
                "marginRight": "16px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "StateLabel"
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "fontSize": "10px",
                    "textAlign": "right"
                  },
                  "text": "State"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "StateValue"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "fallbackDelay": 2.5,
                        "mode": "indirect",
                        "references": {
                          "basePath": "{view.params.basePath}"
                        },
                        "tagPath": "{basePath}/_metrics/OEE/State"
                      },
                      "type": "tag"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Value",
                    "fontSize": "13px",
