            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberformat(max(0, tag({view.params.basePath} + \"/quantitytarget\") - tag({view.params.basePath} + \"/quantityactual\")), '#,##0')"
