        "propConfig": {
          "props.params.basePath": {
            "binding": {
              "config": {
                "expression": "{view.params.basePath}"
              },
              "type": "expr"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "expression": "{view.params.oeeViewPath}"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.view"
      },
      {
