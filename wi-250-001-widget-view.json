{
  "custom": {},
  "params": {
    "basePath": "[default]Path/To/Your/wi-250-001"
  },
  "propConfig": {
    "params.basePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 200,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "WI-250-001"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "Weight"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberformat(tag({view.params.basePath} + \"/PV_kg\"), '#,##0.0') + ' kg'"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Value"
              },
              "text": "0 kg"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "WeightRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
