    "custom.history[0].path": {
      "binding": {
        "config": {
          "expression": "{view.params.basePath}+'/_metric/oee'"
        },
        "type": "expr"
      }
    },
    "params.basePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
