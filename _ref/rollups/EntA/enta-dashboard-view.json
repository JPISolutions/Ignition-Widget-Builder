                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "fallbackDelay": 2.5,
                        "mode": "indirect",
                        "references": {
                          "facilityBasePath": "{view.params.facilityBasePath}"
                        },
                        "tagPath": "{facilityBasePath}/_metadata/_shift/CurrentShift"
