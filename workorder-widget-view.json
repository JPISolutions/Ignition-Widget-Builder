            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberformat(tag({view.params.basePath} + \"/quantityactual\") - tag({view.params.basePath} + \"/quantitydefect\"), '#,##0')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
