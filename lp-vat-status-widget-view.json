{
  "custom": {},
  "params": {
    "basePath": "[default]Cappy Hour Inc/Site1/liquidprocessing/mixroom01/vat01"
  },
  "propConfig": {
    "params.basePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 120,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Name"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/_metadata/assetidentifier/assetname"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "State"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/State/name"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Value"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "HeaderRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "WOLabel"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "Work Order"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "WONumber"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/Work Order/workordernumber"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Value",
                "color": "#2196F3"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "WorkOrderRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "WOProgress"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.max": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "basePath": "{view.params.basePath}"
                },
                "tagPath": "{basePath}/Work Order/quantitytarget"
              },
              "type": "tag"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "basePath": "{view.params.basePath}"
                },
                "tagPath": "{basePath}/Work Order/quantityactual"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "style": {
            "paddingBottom": 5,
            "paddingTop": 5
          },
          "valueDisplay": {
            "enabled": true,
            "format": "#,##0"
          }
        },
        "type": "ia.display.progress"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
