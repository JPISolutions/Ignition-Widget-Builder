{
  "custom": {},
  "params": {
    "basePath": "[default]Cappy Hour Inc/Site1/fillerproduction/fillingline01"
  },
  "propConfig": {
    "params.basePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 100,
      "width": 960
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "WORK ORDER"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "WONumber"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "fallbackDelay": 2.5,
                        "mode": "indirect",
                        "references": {
                          "basePath": "{view.params.basePath}"
                        },
                        "tagPath": "{basePath}/Work Order/workordernumber"
                      },
                      "type": "tag"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Value",
                    "color": "#2196F3",
                    "fontSize": "14px"
                  },
                  "text": "--"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "WOInfo"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "justify": "center",
              "style": {
                "minWidth": "140px",
                "paddingLeft": 8,
                "paddingRight": 8
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "meta": {
                      "name": "QuantityLabel"
                    },
                    "position": {
                      "grow": 1
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "numberformat(tag({view.params.basePath} + '/Work Order/quantityactual'), '#,##0') + ' / ' + numberformat(tag({view.params.basePath} + '/Work Order/quantitytarget'), '#,##0') + ' ' + tag({view.params.basePath} + '/Work Order/uom')"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "classes": "Framework/Card/Label",
                        "fontSize": "10px",
                        "textAlign": "left"
                      },
                      "text": "0 / 0"
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": {
                      "name": "PctLabel"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "numberformat(if(tag({view.params.basePath} + '/Work Order/quantitytarget') > 0, tag({view.params.basePath} + '/Work Order/quantityactual') / tag({view.params.basePath} + '/Work Order/quantitytarget') * 100, 0), '0.0') + '%'"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "classes": "Framework/Card/Label",
                        "fontSize": "10px",
                        "textAlign": "right"
                      },
                      "text": "0%"
                    },
                    "type": "ia.display.label"
                  }
                ],
                "meta": {
                  "name": "ProgressLabels"
                },
                "position": {
                  "shrink": 0
                },
                "props": {},
                "type": "ia.container.flex"
              },
              {
                "meta": {
                  "name": "Progress"
                },
                "position": {
                  "basis": "24px"
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "expression": "tag({view.params.basePath} + '/Work Order/quantityactual')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.max": {
                    "binding": {
                      "config": {
                        "expression": "tag({view.params.basePath} + '/Work Order/quantitytarget')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "max": 100,
                  "style": {
                    "paddingBottom": 4,
                    "paddingTop": 4
                  },
                  "valueDisplay": {
                    "enabled": false
                  }
                },
                "type": "ia.display.progress"
              }
            ],
            "meta": {
              "name": "ProgressSection"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "direction": "column",
              "justify": "center",
              "style": {
                "paddingLeft": 8,
                "paddingRight": 8
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "Value"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "numberformat(tag({view.params.basePath} + '/Work Order/quantitydefect'), '#,##0')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Value",
                    "color": "#F44336",
                    "fontSize": "18px",
                    "textAlign": "center"
                  },
                  "text": "--"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Label"
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "fontSize": "10px",
                    "textAlign": "center"
                  },
                  "text": "Defects"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "DefectsSection"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "justify": "center",
              "style": {
                "classes": "Framework/Card/ContainerWBorder",
                "minWidth": "80px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "Value"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "numberformat((1 - tag({view.params.basePath} + '/Work Order/quantitydefect') / max(1, tag({view.params.basePath} + '/Work Order/quantityactual'))) * 100, '0.00') + '%'"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Value",
                    "fontSize": "18px",
                    "textAlign": "center"
                  },
                  "text": "--%"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Label"
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "fontSize": "10px",
                    "textAlign": "center"
                  },
                  "text": "Yield"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "YieldSection"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "justify": "center",
              "style": {
                "classes": "Framework/Card/ContainerWBorder",
                "minWidth": "80px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "Content"
        },
        "position": {
          "grow": 1
        },
        "props": {},
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
