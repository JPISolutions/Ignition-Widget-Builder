            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "basePath": "{view.params.basePath}"
                },
                "tagPath": "{basePath}.Path"
              },
              "transforms": [
                {
                  "expression": "replace(replace({value}, \u0027[default]\u0027, \u0027\u0027), \u0027/\u0027, \u0027 \u003e \u0027)",
                  "type": "expression"
                }
              ],
              "type": "tag"
            }
          }
        },
        "props": {
          "params": {
            "icon": "dashboard"
          },
