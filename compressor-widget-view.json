            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberformat(tag({view.params.basePath} + '/ElectricalCircuit/Input/Current/value'), '#,##0.0') + ' ' + tag({view.params.basePath} + '/_metadata/ElectricalCircuit/Input/Current/engineeringUnits/displayName')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Value"
              },
              "text": "0"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "MotorCurrentRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "MAINTENANCE"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "MaintenanceHeader"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "RunningTimeProgress"
            },
            "position": {
              "basis": "32px"
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/Statistics/RunningTime/value"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "max": 1000,
              "style": {
                "paddingBottom": 5,
                "paddingTop": 5
              },
              "value": 0,
              "valueDisplay": {
                "enabled": true,
                "format": "#,##0"
              }
            },
            "type": "ia.display.progress"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "MinLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "left"
                  },
                  "text": "0 hrs"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "CenterLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "center"
                  },
                  "text": "Running Time"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "MaxLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "right"
                  },
                  "text": "1000 hrs"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "ProgressLabelRow"
            },
            "props": {
              "style": {
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "MaintenanceContainer"
        },
        "position": {
          "basis": "70px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "justify": "center",
          "style": {
            "classes": "Framework/Card/ContainerWBorder"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
