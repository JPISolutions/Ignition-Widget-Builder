{
  "custom": {},
  "params": {
    "basePath": "[default]Path/To/Your/silo"
  },
  "propConfig": {
    "params.basePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 340,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/Description"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "Silo"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Label"
              },
              "text": "Material"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/Status/Material"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Framework/Card/Value"
              },
              "text": "--"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "MaterialRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Framework/Card/Row"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "LevelGauge"
            },
            "position": {
              "basis": "91.8px"
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "basePath": "{view.params.basePath}"
                    },
                    "tagPath": "{basePath}/Status/Level"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "arc": {
                "width": 10
              },
              "label": {
                "maxDecimal": 1,
                "size": 15
              },
              "maxValue": 100,
              "minValue": 0,
              "style": {
                "marginBottom": 0
              },
              "value": 0
            },
            "type": "ia.chart.simple-gauge"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "MinLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "left"
                  },
                  "text": "0%"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "GaugeLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "center"
                  },
                  "text": "Level"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "MaxLabel"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Framework/Card/Label",
                    "textAlign": "right"
                  },
                  "text": "100%"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "GaugeLabelRow"
            },
            "props": {
              "style": {
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "LevelGaugeContainer"
        },
        "position": {
          "basis": "130px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "justify": "center",
          "style": {
            "classes": "Framework/Card/ContainerWBorder"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
